FLOWISE_PROJECT_NAME=flowise-local
FLOWISE_IMAGE=flowise-local:3.1.4
FLOWISE_CONTAINER_NAME=flowise-local
FLOWISE_PORT=3001
# Create this directory before starting and make it writable by UID/GID 1000,
# the user that runs Flowise in the container.
FLOWISE_DATA_DIR=${HOME}/.flowise
ENABLE_TOOL_CALL_COMPLETED_EVENT=true
HTTP_SECURITY_CHECK=false
